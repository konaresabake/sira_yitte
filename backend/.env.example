# Copiez ce fichier en .env puis adaptez les valeurs. Ne commitez JAMAIS le fichier .env.

# --- Django ---
DEBUG=True
SECRET_KEY=remplacez-par-une-longue-cle-aleatoire
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines du frontend autorisées (CORS / CSRF). En local : le serveur Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Base de données PostgreSQL ---
# postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_LA_BASE
# (si le mot de passe contient @ : / # ou %, remplacez-les par %40 %3A %2F %23 %25)
DATABASE_URL=postgres://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/sira_yitte
# Base distante accessible en externe (adresse externe de Render, Neon...) : décommentez
# DB_SSL_REQUIRE=True

# --- Images (production) ---
# Sans CLOUDINARY_URL, les photos sont enregistrées dans le dossier media/ (développement).
# Sur Render, CLOUDINARY_URL est OBLIGATOIRE : cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=

# --- E-mails (notifications vendeur + confirmation client) ---
# En développement les e-mails s'affichent dans la console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Sira Yitte <no-reply@sirayitte.sn>
# EMAIL_HOST=smtp.exemple.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
