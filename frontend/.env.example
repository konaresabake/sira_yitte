# URL de l'API Django.
# Développement : laissez "/api" (Vite redirige vers http://127.0.0.1:8000).
# Production (Vercel) : définissez cette variable dans Vercel > Settings > Environment Variables, par exemple
#   VITE_API_URL=https://sira-yitte-api.onrender.com/api
# (elle est lue au moment du build : redéployez après l'avoir changée)
VITE_API_URL=/api
# VITE_PROXY_TARGET=http://127.0.0.1:8000
